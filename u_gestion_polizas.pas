UNIT U_GESTION_POLIZAS;

{$MODE OBJFPC}
{$CODEPAGE UTF8}

INTERFACE

USES ARCHIVO_CLIENTES, ARCHIVO_POLIZAS, ARBOL;

PROCEDURE POLIZAS(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES;
  VAR ARCH_POLIZAS: T_ARCHIVO_POLIZAS; ARBOL_DNI: T_ARBOL);

IMPLEMENTATION

USES CRT, SYSUTILS, VALIDACION;

CONST
  MARGEN = '                  '; // 18 espacios para centrar en terminal de 80 columnas

TYPE
  T_VALUACION = RECORD
    MARCA, MODELO: STRING[30];
    ANIO: WORD;
    SUMA: CURRENCY;
  END;

CONST
  {Valores de ejemplo. Reemplazar por la tabla de la consigna si se entrega.}
  TABLA: ARRAY[1..8] OF T_VALUACION = (
    (MARCA: 'FIAT'; MODELO: 'CRONOS'; ANIO: 2022; SUMA: 15000000),
    (MARCA: 'FIAT'; MODELO: 'CRONOS'; ANIO: 2023; SUMA: 16500000),
    (MARCA: 'FORD'; MODELO: 'FIESTA'; ANIO: 2017; SUMA: 10500000),
    (MARCA: 'FORD'; MODELO: 'FIESTA'; ANIO: 2018; SUMA: 11500000),
    (MARCA: 'TOYOTA'; MODELO: 'COROLLA'; ANIO: 2020; SUMA: 18500000),
    (MARCA: 'TOYOTA'; MODELO: 'COROLLA'; ANIO: 2021; SUMA: 20000000),
    (MARCA: 'VOLKSWAGEN'; MODELO: 'GOL TREND'; ANIO: 2018; SUMA: 9500000),
    (MARCA: 'VOLKSWAGEN'; MODELO: 'GOL TREND'; ANIO: 2019; SUMA: 10500000)
  );

FUNCTION CLIENTE_ACTIVO(VAR ARCH: T_ARCHIVO_CLIENTES; ARBOL_DNI: T_ARBOL;
  CONST DNI: STRING): BOOLEAN;
VAR
  POS: LONGINT;
  REG: T_REG_CLIENTES;
BEGIN
  RESULT := FALSE;
  ARBOL_BUSCAR(ARBOL_DNI, DNI, POS);
  IF POS = -1 THEN
    WRITELN(MARGEN, '>> El DNI no corresponde a un cliente registrado. <<')
  ELSE
  BEGIN
    SEEK(ARCH, POS);
    READ(ARCH, REG);
    RESULT := REG.ESTADO;
    IF NOT RESULT THEN
      WRITELN(MARGEN, '>> Cliente inactivo. Reactivelo desde Gestion de Clientes. <<');
  END;
END;

FUNCTION PATENTE_OCUPADA(VAR ARCH: T_ARCHIVO_POLIZAS;
  CONST PATENTE: STRING; POS_OMITIDA: LONGINT): BOOLEAN;
VAR
  POS: LONGINT;
  REG: T_REG_POLIZAS;
BEGIN
  RESULT := FALSE;
  SEEK(ARCH, 0);
  WHILE NOT EOF(ARCH) DO
  BEGIN
    POS := FILEPOS(ARCH);
    READ(ARCH, REG);
    IF (POS <> POS_OMITIDA) AND REG.ESTADO AND (REG.PATENTE = PATENTE) THEN
      EXIT(TRUE);
  END;
END;

FUNCTION LEER_FECHA(CONST MENSAJE: STRING): STRING;
VAR
  FECHA: TDateTime;
  VALIDA: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MARGEN, MENSAJE, ' (AAAAMMDD): ');
    READLN(RESULT);
    RESULT := TRIM(RESULT);
    VALIDA := (LENGTH(RESULT) = 8) AND ESSOLONUMEROS(RESULT);
    IF VALIDA THEN
      VALIDA := TRYENCODEDATE(STRTOINT(COPY(RESULT, 1, 4)),
        STRTOINT(COPY(RESULT, 5, 2)), STRTOINT(COPY(RESULT, 7, 2)), FECHA);
    IF NOT VALIDA THEN
      WRITELN(MARGEN, '>> Fecha invalida. <<');
  UNTIL VALIDA;
END;

FUNCTION CALCULAR_CUOTA(SUMA: CURRENCY; CONST COBERTURA: STRING): CURRENCY;
VAR
  MILESIMAS: INTEGER;
BEGIN
  {Tarifa mensual de ejemplo en milesimas de la suma asegurada.}
  IF COBERTURA = 'RC' THEN MILESIMAS := 2
  ELSE IF COBERTURA = 'IRT' THEN MILESIMAS := 3
  ELSE IF COBERTURA = 'IRTP' THEN MILESIMAS := 4
  ELSE IF COBERTURA = 'TC' THEN MILESIMAS := 5
  ELSE IF COBERTURA = 'TR' THEN MILESIMAS := 7
  ELSE RAISE EConvertError.Create('Cobertura invalida.');
  RESULT := ROUND((SUMA * MILESIMAS / 1000) * 100) / 100;
END;

FUNCTION LEER_VEHICULO(VAR REG: T_REG_POLIZAS): BOOLEAN;
VAR
  I: INTEGER;
BEGIN
  WRITELN;
  WRITELN(MARGEN, '============================================');
  WRITELN(MARGEN, '          VEHICULOS DE REFERENCIA           ');
  WRITELN(MARGEN, '============================================');
  FOR I := LOW(TABLA) TO HIGH(TABLA) DO
    WRITELN(MARGEN, '  ', I, ' - ', TABLA[I].MARCA, ' ', TABLA[I].MODELO, ' (', TABLA[I].ANIO, ')');
  WRITELN(MARGEN, '  0 - Cancelar');
  WRITELN(MARGEN, '--------------------------------------------');
  I := VALIDARENTERO(MARGEN + 'Seleccione marca, modelo y anio', 0, HIGH(TABLA));
  RESULT := I <> 0;
  IF RESULT THEN
  BEGIN
    REG.MARCA := TABLA[I].MARCA;
    REG.MODELO := TABLA[I].MODELO;
    REG.ANIO := TABLA[I].ANIO;
    REG.SUMA_ASEGURADA := TABLA[I].SUMA;
  END;
END;

PROCEDURE LEER_VIGENCIA(VAR REG: T_REG_POLIZAS);
BEGIN
  REG.FECHA_INICIO := LEER_FECHA('Fecha de inicio');
  REPEAT
    REG.FECHA_FIN := LEER_FECHA('Fecha de fin');
    IF REG.FECHA_FIN < REG.FECHA_INICIO THEN
      WRITELN(MARGEN, '>> La fecha de fin debe ser igual o posterior al inicio. <<');
  UNTIL REG.FECHA_FIN >= REG.FECHA_INICIO;
END;

PROCEDURE MOSTRAR_POLIZA(CONST REG: T_REG_POLIZAS);
BEGIN
  WRITELN;
  WRITELN(MARGEN, '--------------------------------------------');
  WRITELN(MARGEN, 'Poliza Nro. ', REG.NRO_POLIZA, ' | DNI ', REG.DNI, ' | ', REG.PATENTE);
  WRITELN(MARGEN, REG.MARCA, ' ', REG.MODELO, ' ', REG.ANIO);
  WRITELN(MARGEN, 'Fecha de carga: ', REG.FECHA_CARGA);
  WRITELN(MARGEN, 'Vigencia: ', REG.FECHA_INICIO, ' - ', REG.FECHA_FIN);
  WRITELN(MARGEN, 'Cobertura: ', REG.COBERTURA, ' | Suma asegurada: $', REG.SUMA_ASEGURADA:0:2,
    ' | Cuota: $', REG.VALOR_CUOTA:0:2);
  IF REG.ESTADO THEN
    WRITELN(MARGEN, 'Estado: ACTIVA')
  ELSE
    WRITELN(MARGEN, 'Estado: BAJA LOGICA');
  WRITELN(MARGEN, '--------------------------------------------');
END;

PROCEDURE GUARDAR(VAR ARCH: T_ARCHIVO_POLIZAS; POS: LONGINT;
  CONST REG: T_REG_POLIZAS);
BEGIN
  SEEK(ARCH, POS);
  WRITE(ARCH, REG);
END;

PROCEDURE DAR_ALTA(VAR ARCH_CLI: T_ARCHIVO_CLIENTES; ARBOL_DNI: T_ARBOL;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS; CONST DNI, PATENTE: STRING);
VAR
  REG: T_REG_POLIZAS;
  POS: LONGINT;
BEGIN
  IF NOT CLIENTE_ACTIVO(ARCH_CLI, ARBOL_DNI, DNI) THEN EXIT;
  IF PATENTE_OCUPADA(ARCH_POL, PATENTE, -1) THEN
  BEGIN
    WRITELN(MARGEN, '>> Ya existe una poliza activa para esa patente. <<');
    EXIT;
  END;

  POS := FILESIZE(ARCH_POL);
  REG.NRO_POLIZA := POS + 1;
  REG.DNI := DNI;
  REG.FECHA_CARGA := FORMATDATETIME('yyyymmdd', DATE);
  REG.PATENTE := PATENTE;
  REG.ESTADO := TRUE;
  IF NOT LEER_VEHICULO(REG) THEN EXIT;
  LEER_VIGENCIA(REG);
  REG.COBERTURA := LEERCOBERTURA(MARGEN + 'Cobertura');
  REG.VALOR_CUOTA := CALCULAR_CUOTA(REG.SUMA_ASEGURADA, REG.COBERTURA);
  MOSTRAR_POLIZA(REG);
  IF LEERCONFIRMACION(MARGEN + '¿Confirma el alta?') THEN
  BEGIN
    GUARDAR(ARCH_POL, POS, REG);
    WRITELN(MARGEN, '>> Poliza registrada con exito. <<');
  END;
END;

{Busca por DNI y patente. Muestra las coincidencias en orden de numero
 y devuelve la posicion relativa de la poliza activa, si existe.}
PROCEDURE BUSCAR_POLIZAS(VAR ARCH: T_ARCHIVO_POLIZAS; CONST DNI, PATENTE: STRING;
  VAR ENCONTRADA: BOOLEAN; VAR POS_ACTIVA: LONGINT; VAR REG_ACTIVA: T_REG_POLIZAS);
VAR
  REG: T_REG_POLIZAS;
  POS: LONGINT;
BEGIN
  POS_ACTIVA := -1;
  ENCONTRADA := FALSE;
  SEEK(ARCH, 0);
  WHILE NOT EOF(ARCH) DO
  BEGIN
    POS := FILEPOS(ARCH);
    READ(ARCH, REG);
    IF (REG.DNI = DNI) AND (REG.PATENTE = PATENTE) THEN
    BEGIN
      MOSTRAR_POLIZA(REG);
      ENCONTRADA := TRUE;
      IF REG.ESTADO THEN
      BEGIN
        POS_ACTIVA := POS;
        REG_ACTIVA := REG;
      END;
    END;
  END;
END;

PROCEDURE MODIFICAR(VAR ARCH_CLI: T_ARCHIVO_CLIENTES; ARBOL_DNI: T_ARBOL;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS; POS: LONGINT; REG: T_REG_POLIZAS);
VAR
  OP: INTEGER;
  PATENTE_NUEVA, DNI_NUEVO: STRING;
BEGIN
  WRITELN;
  WRITELN(MARGEN, '============================================');
  WRITELN(MARGEN, '           MODIFICACION DE POLIZA           ');
  WRITELN(MARGEN, '============================================');
  WRITELN(MARGEN, '  1 - Vigencia');
  WRITELN(MARGEN, '  2 - Marca, modelo y anio');
  WRITELN(MARGEN, '  3 - Cobertura');
  WRITELN(MARGEN, '  4 - Patente');
  WRITELN(MARGEN, '  5 - DNI del titular');
  WRITELN(MARGEN, '  0 - Cancelar');
  WRITELN(MARGEN, '--------------------------------------------');
  OP := VALIDARENTERO(MARGEN + 'Seleccione el campo a modificar', 0, 5);
  CASE OP OF
    0: EXIT;
    1: LEER_VIGENCIA(REG);
    2: IF NOT LEER_VEHICULO(REG) THEN EXIT;
    3: REG.COBERTURA := LEERCOBERTURA(MARGEN + 'Nueva cobertura');
    4: BEGIN
         PATENTE_NUEVA := LEERPATENTE(MARGEN + 'Nueva patente');
         IF PATENTE_OCUPADA(ARCH_POL, PATENTE_NUEVA, POS) THEN
         BEGIN
           WRITELN(MARGEN, '>> Ya existe una poliza activa para esa patente. <<');
           EXIT;
         END;
         REG.PATENTE := PATENTE_NUEVA;
       END;
    5: BEGIN
         DNI_NUEVO := LEERDNI(MARGEN + 'DNI del nuevo titular');
         IF NOT CLIENTE_ACTIVO(ARCH_CLI, ARBOL_DNI, DNI_NUEVO) THEN EXIT;
         REG.DNI := DNI_NUEVO;
       END;
  END;
  IF OP IN [2, 3] THEN
    REG.VALOR_CUOTA := CALCULAR_CUOTA(REG.SUMA_ASEGURADA, REG.COBERTURA);
  MOSTRAR_POLIZA(REG);
  IF LEERCONFIRMACION(MARGEN + '¿Confirma la modificacion?') THEN
  BEGIN
    GUARDAR(ARCH_POL, POS, REG);
    WRITELN(MARGEN, '>> Poliza modificada con exito. <<');
  END;
END;

PROCEDURE POLIZAS(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES;
  VAR ARCH_POLIZAS: T_ARCHIVO_POLIZAS; ARBOL_DNI: T_ARBOL);
VAR
  OP: INTEGER;
  POS: LONGINT;
  DNI, PATENTE: STRING;
  REG: T_REG_POLIZAS;
  ENCONTRADA: BOOLEAN;
BEGIN
  CLRSCR;
  WRITELN(MARGEN, '============================================');
  WRITELN(MARGEN, '             GESTION DE POLIZAS             ');
  WRITELN(MARGEN, '============================================');
  WRITELN;
  DNI := LEERDNI(MARGEN + 'DNI del titular');
  PATENTE := LEERPATENTE(MARGEN + 'Ingrese patente');
  BUSCAR_POLIZAS(ARCH_POLIZAS, DNI, PATENTE, ENCONTRADA, POS, REG);

  IF NOT ENCONTRADA THEN
  BEGIN
    WRITELN;
    WRITELN(MARGEN, 'No hay polizas para ese DNI y patente.');
    DAR_ALTA(ARCH_CLIENTES, ARBOL_DNI, ARCH_POLIZAS, DNI, PATENTE);
  END
  ELSE IF POS >= 0 THEN
  BEGIN
    WRITELN;
    WRITELN(MARGEN, '--------------------------------------------');
    WRITELN(MARGEN, '  1 - Baja logica');
    WRITELN(MARGEN, '  2 - Modificar');
    WRITELN(MARGEN, '  0 - Volver');
    WRITELN(MARGEN, '--------------------------------------------');
    OP := VALIDARENTERO(MARGEN + 'Opcion', 0, 2);
    CASE OP OF
      0: EXIT;
      1: IF LEERCONFIRMACION(MARGEN + '¿Confirma la baja logica?') THEN
         BEGIN
           REG.ESTADO := FALSE;
           GUARDAR(ARCH_POLIZAS, POS, REG);
           WRITELN(MARGEN, '>> Baja logica aplicada correctamente. <<');
         END;
      2: MODIFICAR(ARCH_CLIENTES, ARBOL_DNI, ARCH_POLIZAS, POS, REG);
    END;
  END;
  IF ENCONTRADA AND (POS = -1) THEN
    IF LEERCONFIRMACION(MARGEN + 'Solo hay polizas dadas de baja. ¿Desea emitir una nueva?') THEN
      DAR_ALTA(ARCH_CLIENTES, ARBOL_DNI, ARCH_POLIZAS, DNI, PATENTE);
  WRITELN;
  WRITE(MARGEN, 'Presione Enter para volver al menu principal...');
  READLN;
END;

END.
