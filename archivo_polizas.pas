UNIT ARCHIVO_POLIZAS;

{$MODE OBJFPC}
{$CODEPAGE UTF8}

INTERFACE

CONST
  RUTA_POLIZAS = 'Arch_polizas.dat';

TYPE
  T_REG_POLIZAS = RECORD
    NRO_POLIZA: LONGINT;
    DNI: STRING[8];
    FECHA_CARGA: STRING[8];
    FECHA_INICIO, FECHA_FIN: STRING[8];
    MARCA, MODELO: STRING[30];
    ANIO: WORD;
    PATENTE: STRING[7];
    SUMA_ASEGURADA: CURRENCY;
    COBERTURA: STRING[4];
    VALOR_CUOTA: CURRENCY;
    ESTADO: BOOLEAN;
  END;

  T_ARCHIVO_POLIZAS = FILE OF T_REG_POLIZAS;

PROCEDURE CREAR_ABRIR(VAR ARCH_POL: T_ARCHIVO_POLIZAS);
PROCEDURE CERRAR(VAR ARCH_POL: T_ARCHIVO_POLIZAS);

IMPLEMENTATION

USES SYSUTILS;

PROCEDURE CREAR_ABRIR(VAR ARCH_POL: T_ARCHIVO_POLIZAS);
VAR
  RUTA_COMPLETA: STRING;
  ERROR_APERTURA: INTEGER;
BEGIN
  RUTA_COMPLETA := EXTRACTFILEPATH(PARAMSTR(0)) + RUTA_POLIZAS;
  ASSIGN(ARCH_POL, RUTA_COMPLETA);
  {$I-}
  RESET(ARCH_POL);
  {$I+}
  ERROR_APERTURA := IORESULT;
  IF ERROR_APERTURA = 2 THEN
    REWRITE(ARCH_POL)
  ELSE IF ERROR_APERTURA <> 0 THEN
    RAISE EInOutError.CreateFmt('No se pudo abrir %s (error %d).',
      [RUTA_COMPLETA, ERROR_APERTURA]);
END;

PROCEDURE CERRAR(VAR ARCH_POL: T_ARCHIVO_POLIZAS);
BEGIN
  CLOSE(ARCH_POL);
END;

END.
