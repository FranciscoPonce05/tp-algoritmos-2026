UNIT LISTADOS;

{$CODEPAGE UTF8}

INTERFACE

USES
  CRT, SYSUTILS, ARCHIVO_CLIENTES, VALIDACION;

TYPE
  T_PUNT = ^T_NODO_ARB;
  T_NODO_ARB = RECORD
    CLAVE: STRING[100];
    POS: INTEGER;
    IZQ, DER: T_PUNT;
  END;

  T_REG_POLIZAS = RECORD
    NRO_POLIZA: LONGINT;
    DNI_CLIENTE: STRING[8];
    PATENTE: STRING[7];
    COBERTURA: STRING[4];
    FECHA_DESDE: STRING[8];
    FECHA_HASTA: STRING[8];
    MONTO: REAL;
    VIGENTE: BOOLEAN;
    ACTIVA: BOOLEAN;
  END;

  T_ARCHIVO_POLIZAS = FILE OF T_REG_POLIZAS;

PROCEDURE MENU_LISTADOS(VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
                        VAR ARCH_POL: T_ARCHIVO_POLIZAS;
                        ARBOL_NOM: T_PUNT);

PROCEDURE LISTADO_1_CLIENTES_INORDEN(VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
                                     ARBOL_NOM: T_PUNT);

PROCEDURE LISTADO_2_POLIZAS_POR_CLIENTE(VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
                                        VAR ARCH_POL: T_ARCHIVO_POLIZAS);

PROCEDURE LISTADO_3_POLIZAS_VIGENTES_FECHA(VAR ARCH_POL: T_ARCHIVO_POLIZAS);

PROCEDURE LISTADO_4_5_CONSULTA_E_IMPRESION_PATENTE(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS);

IMPLEMENTATION

CONST
  RUTA_POLIZAS = 'C:\Users\juare\OneDrive\Escritorio\ProyectoFinalAlgoritmo\ARCHIVO_POLIZAS\ARCH_POLIZA.DAT';
  RUTA_SALIDA_TXT = 'C:\Users\juare\OneDrive\Escritorio\ProyectoFinalAlgoritmo\SALIDA_POLIZA.TXT';

PROCEDURE ASEGURAR_ARCHIVO_CLIENTES(VAR ARCH_CLI: T_ARCHIVO_CLIENTES);
BEGIN
  CREAR_ABRIR(ARCH_CLI);
END;

PROCEDURE ASEGURAR_ARCHIVO_POLIZAS(VAR ARCH_POL: T_ARCHIVO_POLIZAS);
BEGIN
  ASSIGN(ARCH_POL, RUTA_POLIZAS);

  {$I-}
  RESET(ARCH_POL);
  {$I+}

  IF IORESULT <> 0 THEN
  BEGIN
    REWRITE(ARCH_POL);
  END;
END;

FUNCTION NORMALIZAR_FECHA(CONST FECHA: STRING): STRING;
VAR
  LIMPIA: STRING;
BEGIN
  LIMPIA := TRIM(FECHA);
  LIMPIA := STRINGREPLACE(LIMPIA, '/', '', [RFREPLACEALL]);
  LIMPIA := STRINGREPLACE(LIMPIA, '-', '', [RFREPLACEALL]);

  // Convierte DDMMAAAA a AAAAMMDD
  IF (LENGTH(LIMPIA) = 8) AND
     ((COPY(LIMPIA, 1, 4) < '1900') OR
      (COPY(LIMPIA, 1, 4) > '2100')) THEN
  BEGIN
    LIMPIA :=
      COPY(LIMPIA, 5, 4) +
      COPY(LIMPIA, 3, 2) +
      COPY(LIMPIA, 1, 2);
  END;

  NORMALIZAR_FECHA := LIMPIA;
END;

PROCEDURE MOSTRAR_DETALLE_POLIZA(CONST REG_POL: T_REG_POLIZAS;
                                 CONST NOMBRE_CLI: STRING);
BEGIN
  WRITELN('------------------------------------------------------------');
  WRITELN('NRO. POLIZA   : ', REG_POL.NRO_POLIZA);
  WRITELN('DNI TITULAR   : ', REG_POL.DNI_CLIENTE);

  IF NOMBRE_CLI <> '' THEN
    WRITELN('TITULAR       : ', NOMBRE_CLI);

  WRITELN('PATENTE       : ', REG_POL.PATENTE);
  WRITELN('COBERTURA     : ', REG_POL.COBERTURA);
  WRITELN('VIGENCIA DESDE: ', REG_POL.FECHA_DESDE);
  WRITELN('VIGENCIA HASTA: ', REG_POL.FECHA_HASTA);
  WRITELN('MONTO         : $', REG_POL.MONTO:0:2);

  IF REG_POL.VIGENTE THEN
    WRITELN('ESTADO VIG.   : VIGENTE')
  ELSE
    WRITELN('ESTADO VIG.   : NO VIGENTE');

  WRITELN('------------------------------------------------------------');
END;

PROCEDURE GUARDAR_POLIZA_TXT(CONST REG_POL: T_REG_POLIZAS;
                             CONST CLI: T_REG_CLIENTES;
                             TIENE_CLI: BOOLEAN);
VAR
  ARCH_TXT: TEXT;
BEGIN
  ASSIGN(ARCH_TXT, RUTA_SALIDA_TXT);

  {$I-}
  REWRITE(ARCH_TXT);
  {$I+}

  IF IORESULT <> 0 THEN
  BEGIN
    WRITELN('ERROR: no se pudo crear ', RUTA_SALIDA_TXT);
    EXIT;
  END;

  WRITELN(ARCH_TXT, '============================================================');
  WRITELN(ARCH_TXT, '             COMPROBANTE / DETALLE DE POLIZA');
  WRITELN(ARCH_TXT, '============================================================');
  WRITELN(ARCH_TXT, 'NRO. POLIZA    : ', REG_POL.NRO_POLIZA);
  WRITELN(ARCH_TXT, 'PATENTE        : ', REG_POL.PATENTE);
  WRITELN(ARCH_TXT, 'COBERTURA      : ', REG_POL.COBERTURA);
  WRITELN(ARCH_TXT, 'VIGENCIA DESDE : ', REG_POL.FECHA_DESDE);
  WRITELN(ARCH_TXT, 'VIGENCIA HASTA : ', REG_POL.FECHA_HASTA);
  WRITELN(ARCH_TXT, 'MONTO          : $', REG_POL.MONTO:0:2);

  IF REG_POL.VIGENTE THEN
    WRITELN(ARCH_TXT, 'ESTADO         : VIGENTE')
  ELSE
    WRITELN(ARCH_TXT, 'ESTADO         : NO VIGENTE');

  WRITELN(ARCH_TXT, '------------------------------------------------------------');
  WRITELN(ARCH_TXT, 'DATOS DEL ASEGURADO');

  IF TIENE_CLI THEN
  BEGIN
    WRITELN(ARCH_TXT, 'DNI            : ', CLI.DNI);
    WRITELN(ARCH_TXT, 'APELLIDO/NOMBRE: ', CLI.APEYNOM);
    WRITELN(ARCH_TXT, 'DIRECCION      : ', CLI.DIREC);
    WRITELN(ARCH_TXT, 'FECHA NAC.     : ', CLI.FNAC);
    WRITELN(ARCH_TXT, 'CELULAR        : ', CLI.CEL);
    WRITELN(ARCH_TXT, 'EMAIL          : ', CLI.MAIL);
  END
  ELSE
  BEGIN
    WRITELN(ARCH_TXT, 'DNI            : ', REG_POL.DNI_CLIENTE);
    WRITELN(ARCH_TXT, 'No se encontraron datos del cliente.');
  END;

  WRITELN(ARCH_TXT, '============================================================');
  CLOSE(ARCH_TXT);

  WRITELN;
  WRITELN('Exportacion completada en: ', RUTA_SALIDA_TXT);
END;

PROCEDURE RECORRER_INORDEN_CLIENTES(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  NODO: T_PUNT;
  VAR CONTADOR: INTEGER);

VAR
  REG_CLI: T_REG_CLIENTES;
BEGIN
  IF NODO <> NIL THEN
  BEGIN
    RECORRER_INORDEN_CLIENTES(ARCH_CLI, NODO^.IZQ, CONTADOR);

    IF (NODO^.POS >= 0) AND
       (NODO^.POS < FILESIZE(ARCH_CLI)) THEN
    BEGIN
      SEEK(ARCH_CLI, NODO^.POS);
      READ(ARCH_CLI, REG_CLI);

      IF REG_CLI.ESTADO THEN
      BEGIN
        INC(CONTADOR);
        WRITELN(CONTADOR:3, '. ', REG_CLI.APEYNOM,
                ' | DNI: ', REG_CLI.DNI,
                ' | CEL: ', REG_CLI.CEL,
                ' | MAIL: ', REG_CLI.MAIL);
      END;
    END;

    RECORRER_INORDEN_CLIENTES(ARCH_CLI, NODO^.DER, CONTADOR);
  END;
END;

PROCEDURE LISTADO_1_CLIENTES_INORDEN(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  ARBOL_NOM: T_PUNT);

VAR
  CONTADOR: INTEGER;
BEGIN
  CLRSCR;
  WRITELN('=== LISTADO 1: CLIENTES ORDENADOS ALFABETICAMENTE ===');
  WRITELN;

  ASEGURAR_ARCHIVO_CLIENTES(ARCH_CLI);

  IF (FILESIZE(ARCH_CLI) = 0) OR (ARBOL_NOM = NIL) THEN
  BEGIN
    WRITELN('No hay clientes registrados o el arbol esta vacio.');
  END
  ELSE
  BEGIN
    CONTADOR := 0;
    RECORRER_INORDEN_CLIENTES(ARCH_CLI, ARBOL_NOM, CONTADOR);

    IF CONTADOR = 0 THEN
      WRITELN('No hay clientes activos.');
  END;

  CERRAR(ARCH_CLI);
  WRITELN;
  WRITELN('Presione una tecla para continuar...');
  READKEY;
END;

PROCEDURE LISTADO_2_POLIZAS_POR_CLIENTE(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS);

VAR
  DNI_BUSCADO: STRING;
  REG_CLI: T_REG_CLIENTES;
  REG_POL: T_REG_POLIZAS;
  ENCONTRADO_CLI: BOOLEAN;
  CANT_POLIZAS: INTEGER;
BEGIN
  CLRSCR;
  WRITELN('=== LISTADO 2: POLIZAS POR CLIENTE ===');
  WRITELN;

  DNI_BUSCADO := LEERDNI('Ingrese el DNI del cliente');

  ASEGURAR_ARCHIVO_CLIENTES(ARCH_CLI);
  ENCONTRADO_CLI := FALSE;

  WHILE (NOT EOF(ARCH_CLI)) AND (NOT ENCONTRADO_CLI) DO
  BEGIN
    READ(ARCH_CLI, REG_CLI);

    IF (REG_CLI.DNI = DNI_BUSCADO) AND REG_CLI.ESTADO THEN
      ENCONTRADO_CLI := TRUE;
  END;

  CERRAR(ARCH_CLI);

  WRITELN;
  WRITELN('-------------------- DATOS DEL CLIENTE ---------------------');

  IF ENCONTRADO_CLI THEN
  BEGIN
    WRITELN('DNI            : ', REG_CLI.DNI);
    WRITELN('APELLIDO/NOMBRE: ', REG_CLI.APEYNOM);
    WRITELN('DIRECCION      : ', REG_CLI.DIREC);
    WRITELN('FECHA NAC.     : ', REG_CLI.FNAC);
    WRITELN('CELULAR        : ', REG_CLI.CEL);
    WRITELN('EMAIL          : ', REG_CLI.MAIL);
  END
  ELSE
  BEGIN
    WRITELN('Cliente no encontrado o inactivo.');
    WRITELN;
    WRITELN('Presione una tecla para continuar...');
    READKEY;
    EXIT;
  END;

  WRITELN('-------------------- DETALLE DE POLIZAS --------------------');
  ASEGURAR_ARCHIVO_POLIZAS(ARCH_POL);
  CANT_POLIZAS := 0;

  WHILE NOT EOF(ARCH_POL) DO
  BEGIN
    READ(ARCH_POL, REG_POL);

    IF (REG_POL.DNI_CLIENTE = DNI_BUSCADO) AND REG_POL.ACTIVA THEN
    BEGIN
      INC(CANT_POLIZAS);
      MOSTRAR_DETALLE_POLIZA(REG_POL, '');
    END;
  END;

  CLOSE(ARCH_POL);

  IF CANT_POLIZAS = 0 THEN
    WRITELN('El cliente no tiene polizas activas.')
  ELSE
    WRITELN('TOTAL DE POLIZAS: ', CANT_POLIZAS);

  WRITELN;
  WRITELN('Presione una tecla para continuar...');
  READKEY;
END;

PROCEDURE LISTADO_3_POLIZAS_VIGENTES_FECHA(
  VAR ARCH_POL: T_ARCHIVO_POLIZAS);

TYPE
  T_ARR_POLIZAS = ARRAY OF T_REG_POLIZAS;

VAR
  ARR: T_ARR_POLIZAS;
  REG_POL: T_REG_POLIZAS;
  TOTAL, I, J: INTEGER;
  AUX: T_REG_POLIZAS;
BEGIN
  CLRSCR;
  WRITELN('=== LISTADO 3: POLIZAS VIGENTES POR FECHA DESDE ===');
  WRITELN;

  ASEGURAR_ARCHIVO_POLIZAS(ARCH_POL);
  SETLENGTH(ARR, 0);
  TOTAL := 0;

  WHILE NOT EOF(ARCH_POL) DO
  BEGIN
    READ(ARCH_POL, REG_POL);

    IF REG_POL.ACTIVA AND REG_POL.VIGENTE THEN
    BEGIN
      INC(TOTAL);
      SETLENGTH(ARR, TOTAL);
      ARR[TOTAL - 1] := REG_POL;
    END;
  END;

  CLOSE(ARCH_POL);

  IF TOTAL = 0 THEN
  BEGIN
    WRITELN('No hay polizas vigentes.');
  END
  ELSE
  BEGIN
    FOR I := 0 TO TOTAL - 2 DO
      FOR J := I + 1 TO TOTAL - 1 DO
      BEGIN
        IF NORMALIZAR_FECHA(ARR[J].FECHA_DESDE) <
           NORMALIZAR_FECHA(ARR[I].FECHA_DESDE) THEN
        BEGIN
          AUX := ARR[I];
          ARR[I] := ARR[J];
          ARR[J] := AUX;
        END;
      END;

    FOR I := 0 TO TOTAL - 1 DO
    BEGIN
      WRITELN('Registro #', I + 1);
      MOSTRAR_DETALLE_POLIZA(ARR[I], '');
    END;
  END;

  WRITELN;
  WRITELN('Presione una tecla para continuar...');
  READKEY;
END;

PROCEDURE LISTADO_4_5_CONSULTA_E_IMPRESION_PATENTE(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS);

VAR
  PATENTE_BUSCADA: STRING;
  REG_POL: T_REG_POLIZAS;
  REG_CLI: T_REG_CLIENTES;
  ENCONTRADA, ENCONTRADO_CLI, EXPORTAR: BOOLEAN;
BEGIN
  CLRSCR;
  WRITELN('=== LISTADOS 4 Y 5: CONSULTA POR PATENTE ===');
  WRITELN;

  PATENTE_BUSCADA :=
    LEERPATENTE('Ingrese la patente');

  ASEGURAR_ARCHIVO_POLIZAS(ARCH_POL);
  ENCONTRADA := FALSE;

  WHILE (NOT EOF(ARCH_POL)) AND (NOT ENCONTRADA) DO
  BEGIN
    READ(ARCH_POL, REG_POL);

    IF REG_POL.ACTIVA AND
       (UPPERCASE(TRIM(REG_POL.PATENTE)) = PATENTE_BUSCADA) THEN
      ENCONTRADA := TRUE;
  END;

  CLOSE(ARCH_POL);

  IF NOT ENCONTRADA THEN
  BEGIN
    WRITELN('No se encontro una poliza activa para la patente ',
            PATENTE_BUSCADA);
  END
  ELSE
  BEGIN
    ASEGURAR_ARCHIVO_CLIENTES(ARCH_CLI);
    ENCONTRADO_CLI := FALSE;

    WHILE (NOT EOF(ARCH_CLI)) AND (NOT ENCONTRADO_CLI) DO
    BEGIN
      READ(ARCH_CLI, REG_CLI);

      IF (REG_CLI.DNI = REG_POL.DNI_CLIENTE) AND
         REG_CLI.ESTADO THEN
        ENCONTRADO_CLI := TRUE;
    END;

    CERRAR(ARCH_CLI);

    WRITELN;

    IF ENCONTRADO_CLI THEN
      MOSTRAR_DETALLE_POLIZA(REG_POL, REG_CLI.APEYNOM)
    ELSE
      MOSTRAR_DETALLE_POLIZA(REG_POL, '');

    EXPORTAR :=
      LEERCONFIRMACION('Desea exportar esta poliza a archivo TXT');

    IF EXPORTAR THEN
      GUARDAR_POLIZA_TXT(REG_POL, REG_CLI, ENCONTRADO_CLI);
  END;

  WRITELN;
  WRITELN('Presione una tecla para continuar...');
  READKEY;
END;

PROCEDURE MENU_LISTADOS(
  VAR ARCH_CLI: T_ARCHIVO_CLIENTES;
  VAR ARCH_POL: T_ARCHIVO_POLIZAS;
  ARBOL_NOM: T_PUNT);

VAR
  OPCION: INTEGER;
BEGIN
  REPEAT
    CLRSCR;
    WRITELN('============================================================');
    WRITELN('                MODULO DE LISTADOS Y SALIDAS');
    WRITELN('============================================================');
    WRITELN('1. Clientes ordenados alfabeticamente');
    WRITELN('2. Polizas por DNI del cliente');
    WRITELN('3. Polizas vigentes por fecha desde');
    WRITELN('4. Consulta por patente e impresion TXT');
    WRITELN('0. Volver');
    WRITELN;

    OPCION := VALIDARENTERO('Seleccione una opcion', 0, 4);

    CASE OPCION OF
      1: LISTADO_1_CLIENTES_INORDEN(ARCH_CLI, ARBOL_NOM);
      2: LISTADO_2_POLIZAS_POR_CLIENTE(ARCH_CLI, ARCH_POL);
      3: LISTADO_3_POLIZAS_VIGENTES_FECHA(ARCH_POL);
      4: LISTADO_4_5_CONSULTA_E_IMPRESION_PATENTE(
           ARCH_CLI, ARCH_POL);
    END;
  UNTIL OPCION = 0;
END;

END.
