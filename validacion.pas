UNIT VALIDACION;

{$CODEPAGE UTF8}

INTERFACE

USES
  SYSUTILS;

// LEE Y VALIDA UN ENTERO DENTRO DE UN RANGO
FUNCTION VALIDARENTERO(MENSAJE: STRING; MIN, MAX: INTEGER): INTEGER;

// LEE Y VALIDA UNA CADENA DE TEXTO QUE NO ESTE VACIA Y SOLO TENGA LETRAS Y ESPACIOS
FUNCTION LEERCADENANOVACIA(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA DIRECCION (NO VACIA, ALFANUMERICA)
FUNCTION LEERDIRECCION(MENSAJE: STRING): STRING;

// VERIFICA QUE UNA CADENA AAAAMMDD SEA UNA FECHA REAL DEL CALENDARIO (MESES, DIAS Y BISIESTOS)
FUNCTION ESFECHAVALIDA(CONST FECHA: STRING): BOOLEAN;

// LEE Y VALIDA UNA FECHA DE NACIMIENTO EN FORMATO AAAAMMDD (EDAD MINIMA 18 ANIOS)
FUNCTION LEERFECHANAC(MENSAJE: STRING): STRING;

// CALCULA LA EDAD EN ANIOS A PARTIR DE UNA FECHA AAAAMMDD
FUNCTION CALCULAR_EDAD(FNAC: STRING): INTEGER;

// LEE Y VALIDA UN CELULAR: SOLO NUMEROS, EXACTAMENTE 10 O 13 DIGITOS (SIN +, - NI ESPACIOS)
FUNCTION LEERCELULAR(MENSAJE: STRING): STRING;

// FUNCION AUXILIAR: VERIFICO QUE UNA CADENA SOLO TENGA LETRAS Y ESPACIOS
FUNCTION ESSOLOTEXTO(CONST CADENA: STRING): BOOLEAN;

// FUNCION AUXILIAR: VERIFICA QUE UNA CADENA SOLO TENGA NUMEROS
FUNCTION ESSOLONUMEROS(CONST CADENA: STRING): BOOLEAN;

// LEE Y VALIDA UN DNI (SOLO NUMEROS, ENTRE 7 Y 8 DIGITOS)
FUNCTION LEERDNI(MENSAJE: STRING): STRING;

// LEE Y VALIDA UN EMAIL (DEBE TENER @ Y UN PUNTO VALIDO)
FUNCTION LEEREMAIL(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA PATENTE (FORMATO AAA111 O AA111AA)
FUNCTION LEERPATENTE(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA COBERTURA (RC, IRT, IRTP, TC, TR)
FUNCTION LEERCOBERTURA(MENSAJE: STRING): STRING;

// LEE UNA ENTRADA BOOLEANA DE TIPO S/N
FUNCTION LEERCONFIRMACION(MENSAJE: STRING): BOOLEAN;

// --- VALIDACIONES PARA POLIZAS ---

// LEE Y VALIDA UNA FECHA DE INICIO DE VIGENCIA (AAAAMMDD, FECHA REAL DEL CALENDARIO)
FUNCTION LEERFECHAVIGENCIA(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA FECHA DE VENCIMIENTO (AAAAMMDD, REAL Y POSTERIOR A LA FECHA DE INICIO)
FUNCTION LEERFECHAVENCIMIENTO(MENSAJE, FECHA_INICIO: STRING): STRING;

// LEE Y VALIDA EL ANIO DEL VEHICULO (ENTRE 1900 Y EL ANIO ACTUAL + 1)
FUNCTION LEERANIOVEHICULO(MENSAJE: STRING): INTEGER;

// LEE Y VALIDA UN ENTERO MAYOR QUE CERO
FUNCTION LEERENTEROPOSITIVO(MENSAJE: STRING): LONGINT;

// LEE Y VALIDA UN NUMERO REAL MAYOR QUE CERO (DECIMALES CON PUNTO)
FUNCTION LEERREALPOSITIVO(MENSAJE: STRING): DOUBLE;


IMPLEMENTATION

FUNCTION ESSOLOTEXTO(CONST CADENA: STRING): BOOLEAN;
VAR
  I: INTEGER;
  CARACTER: CHAR;
  VALIDO: BOOLEAN;
BEGIN
  VALIDO := TRUE;
  I := 1;

  WHILE (I <= LENGTH(CADENA)) AND VALIDO DO
  BEGIN
    CARACTER := CADENA[I];

    {Permite letras de la A a la Z, espacios y bytes >= 128 que corresponden a tildes y la letra ñ en codificacion UTF-8}
    IF NOT (CARACTER IN ['a'..'z', 'A'..'Z', ' ']) AND NOT (ORD(CARACTER) >= 128) THEN
    BEGIN
      VALIDO := FALSE;
    END;

    IF VALIDO THEN
      I := I + 1;
  END;

  ESSOLOTEXTO := VALIDO;
END;


FUNCTION ESSOLONUMEROS(CONST CADENA: STRING): BOOLEAN;
VAR
  I: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  VALIDO := TRUE;
  I := 1;

  WHILE (I <= LENGTH(CADENA)) AND VALIDO DO
  BEGIN
    IF NOT (CADENA[I] IN ['0'..'9']) THEN
      VALIDO := FALSE
    ELSE
      I := I + 1;
  END;

  ESSOLONUMEROS := VALIDO;
END;


{Funcion auxiliar: devuelve el anio actual del sistema usando Date/DecodeDate}
FUNCTION ANIO_ACTUAL: INTEGER;
VAR
  A, M, D: WORD;
BEGIN
  DECODEDATE(DATE, A, M, D);
  ANIO_ACTUAL := A;
END;


FUNCTION VALIDARENTERO(MENSAJE: STRING; MIN, MAX: INTEGER): INTEGER;
VAR
  ENTRADA: STRING;
  VALOR: INTEGER;
  CODIGOERROR: INTEGER;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (' + INTTOSTR(MIN) + ' A ' + INTTOSTR(MAX) + '): ');
    READLN(ENTRADA);
    VAL(ENTRADA, VALOR, CODIGOERROR); {convertir un String en un valor numérico de manera segura.
                                       Devuelve un código de error que es 0 si sale todo bien.}

    IF CODIGOERROR <> 0 THEN
      WRITELN('ERROR: LA ENTRADA NO ES UN NUMERO ENTERO. INTENTE DE NUEVO.')
    ELSE IF (VALOR < MIN) OR (VALOR > MAX) THEN
      WRITELN('ERROR: EL VALOR ESTA FUERA DEL RANGO PERMITIDO [' + INTTOSTR(MIN) + ', ' + INTTOSTR(MAX) + '].');

  UNTIL (CODIGOERROR = 0) AND (VALOR >= MIN) AND (VALOR <= MAX);

  VALIDARENTERO := VALOR;
END;


FUNCTION LEERCADENANOVACIA(MENSAJE: STRING): STRING;
VAR
  CADENA: STRING;
  VALIDA: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(CADENA);

    VALIDA := TRIM(CADENA) <> '';
    IF NOT VALIDA THEN
      WRITELN('ERROR: EL CAMPO NO PUEDE ESTAR VACIO.');

    IF VALIDA AND (NOT ESSOLOTEXTO(CADENA)) THEN
    BEGIN
      WRITELN('ERROR: SOLO SE PERMITEN LETRAS Y ESPACIOS EN ESTE CAMPO.');
      VALIDA := FALSE;
    END;

  UNTIL VALIDA;

  LEERCADENANOVACIA := TRIM(CADENA);
END;


{Solicita una direccion alfanumerica y valida que no quede vacia}
FUNCTION LEERDIRECCION(MENSAJE: STRING): STRING;
VAR
  CADENA: STRING;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(CADENA);
    CADENA := TRIM(CADENA);

    IF CADENA = '' THEN
      WRITELN('ERROR: LA DIRECCION NO PUEDE ESTAR VACIA.');
  UNTIL CADENA <> '';

  LEERDIRECCION := CADENA;
END;


{Verifica que la cadena tenga 8 digitos AAAAMMDD y sea una fecha real: mes 1-12, dias segun el mes y anios bisiestos}
FUNCTION ESFECHAVALIDA(CONST FECHA: STRING): BOOLEAN;
VAR
  ANIO, MES, DIA, CODE, DIAS_MES: INTEGER;
  VALIDA: BOOLEAN;
BEGIN
  VALIDA := (LENGTH(FECHA) = 8) AND ESSOLONUMEROS(FECHA);

  IF VALIDA THEN
  BEGIN
    VAL(COPY(FECHA, 1, 4), ANIO, CODE);
    IF CODE <> 0 THEN VALIDA := FALSE;
    VAL(COPY(FECHA, 5, 2), MES, CODE);
    IF CODE <> 0 THEN VALIDA := FALSE;
    VAL(COPY(FECHA, 7, 2), DIA, CODE);
    IF CODE <> 0 THEN VALIDA := FALSE;

    IF (ANIO < 1) OR (MES < 1) OR (MES > 12) OR (DIA < 1) THEN
      VALIDA := FALSE
    ELSE
    BEGIN
      CASE MES OF
        4, 6, 9, 11: DIAS_MES := 30;
        2: {Calculo de anio bisiesto para validar correctamente el mes de febrero}
           IF ((ANIO MOD 4 = 0) AND (ANIO MOD 100 <> 0)) OR (ANIO MOD 400 = 0) THEN
             DIAS_MES := 29
           ELSE
             DIAS_MES := 28;
      ELSE
        DIAS_MES := 31;
      END;
      VALIDA := DIA <= DIAS_MES;
    END;
  END;

  ESFECHAVALIDA := VALIDA;
END;


{Calcula la edad en anios a partir de una fecha en formato AAAAMMDD, tomando la fecha actual del sistema}
FUNCTION CALCULAR_EDAD(FNAC: STRING): INTEGER;
VAR
  ANIO_NAC, MES_NAC, DIA_NAC, CODE: INTEGER;
  ANIO_ACT, MES_ACT, DIA_ACT: WORD;
  EDAD: INTEGER;
BEGIN
  VAL(COPY(FNAC, 1, 4), ANIO_NAC, CODE);
  IF CODE <> 0 THEN EXIT(0);
  VAL(COPY(FNAC, 5, 2), MES_NAC, CODE);
  IF CODE <> 0 THEN EXIT(0);
  VAL(COPY(FNAC, 7, 2), DIA_NAC, CODE);
  IF CODE <> 0 THEN EXIT(0);

  DECODEDATE(DATE, ANIO_ACT, MES_ACT, DIA_ACT);
  EDAD := ANIO_ACT - ANIO_NAC;
  IF (MES_ACT < MES_NAC) OR ((MES_ACT = MES_NAC) AND (DIA_ACT < DIA_NAC)) THEN
    EDAD := EDAD - 1;
  CALCULAR_EDAD := EDAD;
END;


{Valida una fecha de nacimiento AAAAMMDD: fecha real, anio entre 1920 y el actual, y edad minima de 18 segun la fecha del sistema}
FUNCTION LEERFECHANAC(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  ANIO, CODE: INTEGER;
  EDAD: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (AAAAMMDD): ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);
    VALIDO := ESFECHAVALIDA(ENTRADA);

    IF VALIDO THEN
    BEGIN
      VAL(COPY(ENTRADA, 1, 4), ANIO, CODE);

      IF (CODE <> 0) OR (ANIO < 1920) OR (ANIO > ANIO_ACTUAL) THEN
        VALIDO := FALSE
      ELSE
      BEGIN
        {Control de edad minima para adquirir poliza: al menos 18 anios}
        EDAD := CALCULAR_EDAD(ENTRADA);
        IF EDAD < 18 THEN
        BEGIN
          WRITELN('ERROR: EL CLIENTE DEBE TENER LA EDAD MINIMA PARA ADQUIRIR UNA POLIZA (AL MENOS 18 ANIOS). TIENE ', EDAD, ' ANIOS.');
          VALIDO := FALSE;
        END;
      END;
    END;

    IF NOT VALIDO THEN
      WRITELN('ERROR: FECHA INVALIDA. INGRESE 8 DIGITOS EN FORMATO AAAAMMDD (EJ: 19950521) Y DEBE SER MAYOR DE EDAD.');

  UNTIL VALIDO;

  LEERFECHANAC := ENTRADA;
END;


{Valida el celular: solo digitos (se rechazan +, - y espacios) y longitud exactamente 10 o 13}
FUNCTION LEERCELULAR(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (solo numeros: 10 digitos sin 0 ni 15, ej: 3442123456, o 13 si incluye prefijo pais): ');
    READLN(ENTRADA);

    VALIDO := ESSOLONUMEROS(ENTRADA) AND ((LENGTH(ENTRADA) = 10) OR (LENGTH(ENTRADA) = 13));

    IF NOT VALIDO THEN
      WRITELN('ERROR: CELULAR INVALIDO. SOLO NUMEROS (SIN +, - NI ESPACIOS) Y EXACTAMENTE 10 O 13 DIGITOS.');

  UNTIL VALIDO;

  LEERCELULAR := ENTRADA;
END;


FUNCTION LEERDNI(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);

    VALIDO := (LENGTH(ENTRADA) >= 7) AND (LENGTH(ENTRADA) <= 8) AND ESSOLONUMEROS(ENTRADA);

    IF NOT VALIDO THEN
      WRITELN('ERROR: EL DNI DEBE CONTENER ENTRE 7 Y 8 DIGITOS NUMERICOS.');

  UNTIL VALIDO;

  LEERDNI := ENTRADA;
END;

FUNCTION LEEREMAIL(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  POSARROBA, POSPUNTO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(ENTRADA);
    ENTRADA := LOWERCASE(TRIM(ENTRADA));

    //EL POSARROBA ME ASEGURA QUE HAYA UNA LETRA ANTES DEL @
    POSARROBA := POS('@', ENTRADA);
    //EL POSPUNTO ME ASEGURA QUE ENTRE EL @ Y EL PUNTO HAYA UN CARACTER
    POSPUNTO := LASTDELIMITER('.', ENTRADA);

    VALIDO := (POSARROBA > 1) AND (POSPUNTO > POSARROBA + 1) AND (POSPUNTO < LENGTH(ENTRADA));

    IF NOT VALIDO THEN
      WRITELN('ERROR: DEBE INGRESAR UN FORMATO DE EMAIL VALIDO (EJ: NOMBRE@DOMINIO.COM).');

  UNTIL VALIDO;

  LEEREMAIL := ENTRADA;
END;



FUNCTION LEERPATENTE(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  LARGO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (PATENTE): ');
    READLN(ENTRADA);
    ENTRADA := UPPERCASE(TRIM(ENTRADA));
    LARGO := LENGTH(ENTRADA);
    VALIDO := FALSE;

    // FORMATO VIEJO(6 CARACTERES)
    IF LARGO = 6 THEN
    BEGIN
      IF (ENTRADA[1] IN ['A'..'Z']) AND (ENTRADA[2] IN ['A'..'Z']) AND (ENTRADA[3] IN ['A'..'Z']) AND
         (ENTRADA[4] IN ['0'..'9']) AND (ENTRADA[5] IN ['0'..'9']) AND (ENTRADA[6] IN ['0'..'9']) THEN
        VALIDO := TRUE;
    END
    // FORMATO NUEVO (7 CARACTERES)
    ELSE IF LARGO = 7 THEN
    BEGIN
      IF (ENTRADA[1] IN ['A'..'Z']) AND (ENTRADA[2] IN ['A'..'Z']) AND
         (ENTRADA[3] IN ['0'..'9']) AND (ENTRADA[4] IN ['0'..'9']) AND (ENTRADA[5] IN ['0'..'9']) AND
         (ENTRADA[6] IN ['A'..'Z']) AND (ENTRADA[7] IN ['A'..'Z']) THEN
        VALIDO := TRUE;
    END;

    IF NOT VALIDO THEN
      WRITELN('ERROR: PATENTE INVALIDA. FORMATOS VALIDOS: AAA111 O AA111AA.');

  UNTIL VALIDO;

  LEERPATENTE := ENTRADA;
END;


FUNCTION LEERCOBERTURA(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (RC, IRT, IRTP, TC, TR): ');
    READLN(ENTRADA);
    ENTRADA := UPPERCASE(TRIM(ENTRADA));

    VALIDO := (ENTRADA = 'RC') OR (ENTRADA = 'IRT') OR (ENTRADA = 'IRTP') OR (ENTRADA = 'TC') OR (ENTRADA = 'TR');

    IF NOT VALIDO THEN
      WRITELN('ERROR: TIPO DE COBERTURA INVALIDO. OPCIONES: RC, IRT, IRTP, TC, TR.');

  UNTIL VALIDO;

  LEERCOBERTURA := ENTRADA;
END;


FUNCTION LEERCONFIRMACION(MENSAJE: STRING): BOOLEAN;
VAR
  ENTRADA: CHAR;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (S/N): ');
    READLN(ENTRADA);
    ENTRADA := UPCASE(ENTRADA);

    VALIDO := (ENTRADA = 'S') OR (ENTRADA = 'N');

    IF NOT VALIDO THEN
      WRITELN('ERROR: INGRESE S PARA SI O N PARA NO.');

  UNTIL VALIDO;

  LEERCONFIRMACION := (ENTRADA = 'S');
END;


{Fecha de inicio de vigencia de una poliza: debe ser una fecha real AAAAMMDD con anio 2000 o posterior}
FUNCTION LEERFECHAVIGENCIA(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (AAAAMMDD): ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);

    VALIDO := ESFECHAVALIDA(ENTRADA) AND (ENTRADA >= '20000101');

    IF NOT VALIDO THEN
      WRITELN('ERROR: FECHA INVALIDA. INGRESE UNA FECHA REAL EN FORMATO AAAAMMDD (EJ: 20261126).');

  UNTIL VALIDO;

  LEERFECHAVIGENCIA := ENTRADA;
END;


{Fecha de vencimiento: fecha real y estrictamente posterior al inicio de vigencia (el formato AAAAMMDD permite comparar como texto)}
FUNCTION LEERFECHAVENCIMIENTO(MENSAJE, FECHA_INICIO: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (AAAAMMDD): ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);

    VALIDO := ESFECHAVALIDA(ENTRADA);
    IF NOT VALIDO THEN
      WRITELN('ERROR: FECHA INVALIDA. INGRESE UNA FECHA REAL EN FORMATO AAAAMMDD (EJ: 20271126).')
    ELSE IF ENTRADA <= FECHA_INICIO THEN
    BEGIN
      WRITELN('ERROR: LA FECHA DE VENCIMIENTO DEBE SER POSTERIOR AL INICIO DE VIGENCIA (', FECHA_INICIO, ').');
      VALIDO := FALSE;
    END;

  UNTIL VALIDO;

  LEERFECHAVENCIMIENTO := ENTRADA;
END;


{Anio del vehiculo: entre 1900 y el anio actual + 1 (los modelos del proximo anio ya se venden)}
FUNCTION LEERANIOVEHICULO(MENSAJE: STRING): INTEGER;
BEGIN
  LEERANIOVEHICULO := VALIDARENTERO(MENSAJE, 1900, ANIO_ACTUAL + 1);
END;


{Lee un entero y exige que sea mayor que cero}
FUNCTION LEERENTEROPOSITIVO(MENSAJE: STRING): LONGINT;
VAR
  ENTRADA: STRING;
  VALOR: LONGINT;
  CODIGO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);
    VAL(ENTRADA, VALOR, CODIGO);

    VALIDO := (CODIGO = 0) AND (VALOR > 0);
    IF NOT VALIDO THEN
      WRITELN('ERROR: DEBE INGRESAR UN NUMERO ENTERO MAYOR QUE CERO.');

  UNTIL VALIDO;

  LEERENTEROPOSITIVO := VALOR;
END;


{Lee un numero real (decimales con punto) y exige que sea mayor que cero}
FUNCTION LEERREALPOSITIVO(MENSAJE: STRING): DOUBLE;
VAR
  ENTRADA: STRING;
  VALOR: DOUBLE;
  CODIGO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (mayor que 0, decimales con punto): ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);
    VAL(ENTRADA, VALOR, CODIGO);

    VALIDO := (CODIGO = 0) AND (VALOR > 0);
    IF NOT VALIDO THEN
      WRITELN('ERROR: DEBE INGRESAR UN NUMERO MAYOR QUE CERO.');

  UNTIL VALIDO;

  LEERREALPOSITIVO := VALOR;
END;

END.
