UNIT VALIDACION;

{$CODEPAGE UTF8}

INTERFACE

USES
  SYSUTILS;

// LEE Y VALIDA UN ENTERO DENTRO DE UN RANGO
FUNCTION VALIDARENTERO(MENSAJE: STRING; MIN, MAX: INTEGER): INTEGER;

// LEE Y VALIDA UNA CADENA DE TEXTO QUE NO ESTE VACIA Y SOLO TENGA LETRAS Y ESPACIOS
FUNCTION LEERCADENANOVACIA(MENSAJE: STRING): STRING;

// FUNCION AUXILIAR: VERIFICO QUE UNA CADENA SOLO TENGA LETRAS Y ESPACIOS
FUNCTION ESSOLOTEXTO(CONST CADENA: STRING): BOOLEAN;

// FUNCION AUXILIAR: VERIFICA QUE UNA CADENA SOLO TENGA NUMEROS
FUNCTION ESSOLONUMEROS(CONST CADENA: STRING): BOOLEAN;

// LEE Y VALIDA UN DNI (SOLO NUMEROS, ENTRE 7 Y 8 DIGITOS)
FUNCTION LEERDNI(MENSAJE: STRING): STRING;

// LEE Y VALIDA UN EMAIL (DEBE TENER @ Y UN PUNTO VALIDO)
FUNCTION LEEREMAIL(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA PATENTE (FORMATO AAA111 O AA111AA)
FUNCTION LEERPATENTE(MENSAJE: STRING): STRING;

// LEE Y VALIDA UNA COBERTURA (RC, IRT, IRTP, TC, TR)
FUNCTION LEERCOBERTURA(MENSAJE: STRING): STRING;

// LEE UNA ENTRADA BOOLEANA DE TIPO S/N
FUNCTION LEERCONFIRMACION(MENSAJE: STRING): BOOLEAN;


IMPLEMENTATION

FUNCTION ESSOLOTEXTO(CONST CADENA: STRING): BOOLEAN;
VAR
  I: INTEGER;
  CARACTER: CHAR;
  VALIDO: BOOLEAN;
BEGIN
  VALIDO := TRUE;
  I := 1;

  WHILE (I <= LENGTH(CADENA)) AND VALIDO DO
  BEGIN
    CARACTER := CADENA[I];

    IF NOT ( (CARACTER >= 'a') AND (CARACTER <= 'z') ) AND
       NOT ( (CARACTER >= 'A') AND (CARACTER <= 'Z') ) AND
       NOT (CARACTER = ' ') THEN
    BEGIN
      VALIDO := FALSE;
    END;

    IF VALIDO THEN
      I := I + 1;
  END;

  ESSOLOTEXTO := VALIDO;
END;


FUNCTION ESSOLONUMEROS(CONST CADENA: STRING): BOOLEAN;
VAR
  I: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  VALIDO := TRUE;
  I := 1;

  WHILE (I <= LENGTH(CADENA)) AND VALIDO DO
  BEGIN
    IF NOT (CADENA[I] IN ['0'..'9']) THEN
      VALIDO := FALSE
    ELSE
      I := I + 1;
  END;

  ESSOLONUMEROS := VALIDO;
END;


FUNCTION VALIDARENTERO(MENSAJE: STRING; MIN, MAX: INTEGER): INTEGER;
VAR
  ENTRADA: STRING;
  VALOR: INTEGER;
  CODIGOERROR: INTEGER;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (' + INTTOSTR(MIN) + ' A ' + INTTOSTR(MAX) + '): ');
    READLN(ENTRADA);
    VAL(ENTRADA, VALOR, CODIGOERROR); {convertir un String en un valor numérico de manera segura.
                                       Devuelve un código de error que es 0 si sale todo bien.}

    IF CODIGOERROR <> 0 THEN
      WRITELN('ERROR: LA ENTRADA NO ES UN NUMERO ENTERO. INTENTE DE NUEVO.')
    ELSE IF (VALOR < MIN) OR (VALOR > MAX) THEN
      WRITELN('ERROR: EL VALOR ESTA FUERA DEL RANGO PERMITIDO [' + INTTOSTR(MIN) + ', ' + INTTOSTR(MAX) + '].');

  UNTIL (CODIGOERROR = 0) AND (VALOR >= MIN) AND (VALOR <= MAX);

  VALIDARENTERO := VALOR;
END;


FUNCTION LEERCADENANOVACIA(MENSAJE: STRING): STRING;
VAR
  CADENA: STRING;
  VALIDA: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(CADENA);

    VALIDA := TRIM(CADENA) <> '';
    IF NOT VALIDA THEN
      WRITELN('ERROR: EL CAMPO NO PUEDE ESTAR VACIO.');

    IF VALIDA AND (NOT ESSOLOTEXTO(CADENA)) THEN
    BEGIN
      WRITELN('ERROR: SOLO SE PERMITEN LETRAS Y ESPACIOS EN ESTE CAMPO.');
      VALIDA := FALSE;
    END;

  UNTIL VALIDA;

  LEERCADENANOVACIA := TRIM(CADENA);
END;


FUNCTION LEERDNI(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(ENTRADA);
    ENTRADA := TRIM(ENTRADA);

    VALIDO := (LENGTH(ENTRADA) >= 7) AND (LENGTH(ENTRADA) <= 8) AND ESSOLONUMEROS(ENTRADA);

    IF NOT VALIDO THEN
      WRITELN('ERROR: EL DNI DEBE CONTENER ENTRE 7 Y 8 DIGITOS NUMERICOS.');

  UNTIL VALIDO;

  LEERDNI := ENTRADA;
END;

FUNCTION LEEREMAIL(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  POSARROBA, POSPUNTO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ': ');
    READLN(ENTRADA);
    ENTRADA := LOWERCASE(TRIM(ENTRADA));

    //EL POSARROBA ME ASEGURA QUE HAYA UNA LETRA ANTES DEL @
    POSARROBA := POS('@', ENTRADA);
    //EL POSPUNTO ME ASEGURA QUE ENTRE EL @ Y EL PUNTO HAYA UN CARACTER
    POSPUNTO := LASTDELIMITER('.', ENTRADA);

    VALIDO := (POSARROBA > 1) AND (POSPUNTO > POSARROBA + 1) AND (POSPUNTO < LENGTH(ENTRADA));

    IF NOT VALIDO THEN
      WRITELN('ERROR: DEBE INGRESAR UN FORMATO DE EMAIL VALIDO (EJ: NOMBRE@DOMINIO.COM).');

  UNTIL VALIDO;

  LEEREMAIL := ENTRADA;
END;



FUNCTION LEERPATENTE(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  LARGO: INTEGER;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (PATENTE): ');
    READLN(ENTRADA);
    ENTRADA := UPPERCASE(TRIM(ENTRADA));
    LARGO := LENGTH(ENTRADA);
    VALIDO := FALSE;

    // FORMATO VIEJO(6 CARACTERES)
    IF LARGO = 6 THEN
    BEGIN
      IF (ENTRADA[1] IN ['A'..'Z']) AND (ENTRADA[2] IN ['A'..'Z']) AND (ENTRADA[3] IN ['A'..'Z']) AND
         (ENTRADA[4] IN ['0'..'9']) AND (ENTRADA[5] IN ['0'..'9']) AND (ENTRADA[6] IN ['0'..'9']) THEN
        VALIDO := TRUE;
    END
    // FORMATO NUEVO (7 CARACTERES)
    ELSE IF LARGO = 7 THEN
    BEGIN
      IF (ENTRADA[1] IN ['A'..'Z']) AND (ENTRADA[2] IN ['A'..'Z']) AND
         (ENTRADA[3] IN ['0'..'9']) AND (ENTRADA[4] IN ['0'..'9']) AND (ENTRADA[5] IN ['0'..'9']) AND
         (ENTRADA[6] IN ['A'..'Z']) AND (ENTRADA[7] IN ['A'..'Z']) THEN
        VALIDO := TRUE;
    END;

    IF NOT VALIDO THEN
      WRITELN('ERROR: PATENTE INVALIDA. FORMATOS VALIDOS: AAA111 O AA111AA.');

  UNTIL VALIDO;

  LEERPATENTE := ENTRADA;
END;


FUNCTION LEERCOBERTURA(MENSAJE: STRING): STRING;
VAR
  ENTRADA: STRING;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (RC, IRT, IRTP, TC, TR): ');
    READLN(ENTRADA);
    ENTRADA := UPPERCASE(TRIM(ENTRADA));

    VALIDO := (ENTRADA = 'RC') OR (ENTRADA = 'IRT') OR (ENTRADA = 'IRTP') OR (ENTRADA = 'TC') OR (ENTRADA = 'TR');

    IF NOT VALIDO THEN
      WRITELN('ERROR: TIPO DE COBERTURA INVALIDO. OPCIONES: RC, IRT, IRTP, TC, TR.');

  UNTIL VALIDO;

  LEERCOBERTURA := ENTRADA;
END;


FUNCTION LEERCONFIRMACION(MENSAJE: STRING): BOOLEAN;
VAR
  ENTRADA: CHAR;
  VALIDO: BOOLEAN;
BEGIN
  REPEAT
    WRITE(MENSAJE + ' (S/N): ');
    READLN(ENTRADA);
    ENTRADA := UPCASE(ENTRADA);

    VALIDO := (ENTRADA = 'S') OR (ENTRADA = 'N');

    IF NOT VALIDO THEN
      WRITELN('ERROR: INGRESE S PARA SI O N PARA NO.');

  UNTIL VALIDO;

  LEERCONFIRMACION := (ENTRADA = 'S');
END;

END.
