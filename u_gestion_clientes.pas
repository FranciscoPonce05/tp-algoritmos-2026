UNIT U_GESTION_CLIENTES;

{$CODEPAGE UTF8}

INTERFACE

USES
  ARCHIVO_CLIENTES, CRT, VALIDACION;

PROCEDURE CLIENTES(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES);

IMPLEMENTATION

PROCEDURE LEE_REGISTRO(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES; I: INTEGER; VAR REG: T_REG_CLIENTES);
BEGIN
  SEEK(ARCH_CLIENTES, I);
  READ(ARCH_CLIENTES, REG);
END;

PROCEDURE BUSCAR(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES; BUSCADO: STRING; VAR POS: INTEGER);
VAR
  I: INTEGER;
  REG: T_REG_CLIENTES; // SE DECLARA LA VARIABLE QUE FALTABA
BEGIN
  POS := -1;
  RESET(ARCH_CLIENTES);
  I := 0;

  WHILE (NOT EOF(ARCH_CLIENTES)) AND (POS = -1) DO // CORREGIDO (POS = -1)
  BEGIN
    LEE_REGISTRO(ARCH_CLIENTES, I, REG);
    IF REG.DNI = BUSCADO THEN
      POS := I
    ELSE
      I := I + 1;
  END;

  CERRAR(ARCH_CLIENTES);
END;

PROCEDURE CLIENTES(VAR ARCH_CLIENTES: T_ARCHIVO_CLIENTES);
VAR
  DNI: STRING;
  POS: INTEGER;
BEGIN
  CLRSCR;
  DNI := LEERDNI('INGRESE EL DNI DEL CLIENTE'); // INTEGRAMOS VALIDACION

  CREAR_ABRIR(ARCH_CLIENTES);
  IF FILESIZE(ARCH_CLIENTES) > 0 THEN
  BEGIN
    BUSCAR(ARCH_CLIENTES, DNI, POS);
    IF POS <> -1 THEN
      WRITELN('CLIENTE ENCONTRADO EN LA POSICION: ', POS)
    ELSE
      WRITELN('CLIENTE NO ENCONTRADO.');
  END
  ELSE
    WRITELN('EL ARCHIVO DE CLIENTES ESTA VACIO.');

  WRITELN;
  WRITELN('PRESIONE UNA TECLA PARA CONTINUAR...');
  READKEY;
END;

END.
