UNIT MENU;

{$MODE OBJFPC}
{$CODEPAGE UTF8}

INTERFACE

USES
  CRT, SYSUTILS, ARCHIVO_CLIENTES, ARCHIVO_POLIZAS, ARBOL,
  U_GESTION_CLIENTES, U_GESTION_POLIZAS, U_GESTION_LISTADOS,
  U_GESTION_ESTADISTICAS, VALIDACION;

PROCEDURE MENU_PRINCIPAL;

IMPLEMENTATION

PROCEDURE MENU_PRINCIPAL;
VAR
  ARCH_CLIENTES: T_ARCHIVO_CLIENTES;
  ARCH_POLIZAS: T_ARCHIVO_POLIZAS;
  ARBOL_DNI, ARBOL_NOM: T_PUNT;
  OPCION: INTEGER;
  ENTRADA: STRING;
  CODIGO: INTEGER;
  OPCION_VALIDA: BOOLEAN;
BEGIN
  // CREAR Y ABRIR ARCHIVOS
  ARCHIVO_CLIENTES.CREAR_ABRIR(ARCH_CLIENTES);
  ARCHIVO_POLIZAS.CREAR_ABRIR(ARCH_POLIZAS);

  // CARGAR ARBOLES EN MEMORIA AL INICIAR EL PROGRAMA (REQUERIMIENTO ENTREGABLE 2)
  GENERAR_ARBOLES(ARCH_CLIENTES, ARBOL_DNI, ARBOL_NOM);

  REPEAT
    REPEAT
      CLRSCR;
      GOTOXY(18, 5);  WRITE('============================================');
      GOTOXY(18, 6);  WRITE('       SISTEMA DE GESTION DE SEGUROS        ');
      GOTOXY(18, 7);  WRITE('               MENU PRINCIPAL               ');
      GOTOXY(18, 8);  WRITE('============================================');
      GOTOXY(26, 11); WRITE('1 - GESTION DE CLIENTES');
      GOTOXY(26, 13); WRITE('2 - GESTION DE POLIZAS');
      GOTOXY(26, 15); WRITE('3 - LISTADOS');
      GOTOXY(26, 17); WRITE('4 - ESTADISTICAS');
      GOTOXY(26, 19); WRITE('0 - FINALIZAR');
      GOTOXY(18, 21); WRITE('--------------------------------------------');
      GOTOXY(22, 23); WRITE('INGRESE OPCION [0..4]: ');

      {Se lee como cadena de texto para evitar que el programa aborte con Runtime Error 106 si el usuario ingresa letras}
      READLN(ENTRADA);
      ENTRADA := TRIM(ENTRADA);

      {VAL intenta convertir el texto a numero. Si hay letras o caracteres invalidos, CODIGO es distinto de 0}
      VAL(ENTRADA, OPCION, CODIGO);
      OPCION_VALIDA := (CODIGO = 0) AND (LENGTH(ENTRADA) > 0) AND (OPCION >= 0) AND (OPCION <= 4);

      IF NOT OPCION_VALIDA THEN
      BEGIN
        {Muestra el mensaje de error y espera una tecla; el bucle limpia la pantalla con CLRSCR para redibujar el menu alineado}
        GOTOXY(16, 25);
        WRITE('>> ERROR: Debe ingresar un numero entre 0 y 4. <<');
        GOTOXY(22, 26);
        WRITE('Presione una tecla para reintentar...');
        READKEY;
      END;
    UNTIL OPCION_VALIDA;

    CASE OPCION OF
      1: CLIENTES(ARCH_CLIENTES, ARBOL_DNI, ARBOL_NOM);
      2: POLIZAS(ARCH_CLIENTES, ARCH_POLIZAS, ARBOL_DNI);
      3: LISTADOS(ARCH_CLIENTES, ARCH_POLIZAS, ARBOL_NOM);
      4: ESTADISTICAS(ARCH_CLIENTES, ARCH_POLIZAS);
    END;
  UNTIL OPCION = 0;

  // LIBERAR MEMORIA DE ARBOLES Y CERRAR ARCHIVOS
  DESTRUIR_ARBOL(ARBOL_DNI);
  DESTRUIR_ARBOL(ARBOL_NOM);
  ARCHIVO_POLIZAS.CERRAR(ARCH_POLIZAS);
  ARCHIVO_CLIENTES.CERRAR(ARCH_CLIENTES);
END;

END.
